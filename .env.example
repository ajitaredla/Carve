# Supabase project settings (Project Settings > API in the Supabase dashboard).
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time — never
# put the service-role key behind a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Service-role key — server-only, bypasses Row Level Security. Not used by
# the code added in task 1.0 (no admin client yet); reserved for future
# server-only work (e.g. the MCP server in task 4.0). NEVER import this in
# any file reachable from a Client Component.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma / Postgres (Supabase > Project Settings > Database).
# DATABASE_URL: pooled connection (pgbouncer / transaction mode, port 6543)
# — used by the runtime PrismaClient in lib/prisma.ts.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: direct (non-pooled) connection, port 5432 — used by
# prisma.config.ts for `prisma migrate` / `prisma studio`.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:5432/postgres"

# Carve MCP server (app/api/mcp/route.ts, task 4.0) — a single shared bearer
# token machine callers must send as `Authorization: Bearer <token>`. There is
# no per-founder identity at this layer; brand-ownership checks happen
# upstream in the calling Server Action (see lib/auth/current-brand.ts). In
# production this is the credential a Claude Managed Agents Vault holds
# (task 5.0) and attaches to both the carve-generator and carve-verifier
# sessions via vault_ids — generate a long random value, e.g.
# `openssl rand -hex 32`, never reuse the example below.
MCP_SERVER_TOKEN="generate-a-long-random-value-do-not-use-this-placeholder"

# Claude Managed Agents resources (task 5.0). Created once via the API from the
# YAML configs in agents/ (control plane), then referenced by id at session-
# create time by the Server Action (data plane, task 6.0). Re-create with:
#   ant beta:environments create < agents/carve-cloud.environment.yaml
#   ant beta:agents       create < agents/carve-generator.agent.yaml
#   ant beta:agents       create < agents/carve-verifier.agent.yaml
# and a vault + static_bearer credential holding MCP_SERVER_TOKEN above, keyed
# by the deployed /api/mcp URL. The vault attaches to each session via vault_ids.
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx"
CARVE_ENVIRONMENT_ID="env_xxxxxxxxxxxxxxxxxxxxxxxx"
CARVE_GENERATOR_AGENT_ID="agent_xxxxxxxxxxxxxxxxxxxxxxxx"
CARVE_VERIFIER_AGENT_ID="agent_xxxxxxxxxxxxxxxxxxxxxxxx"
CARVE_VAULT_ID="vlt_xxxxxxxxxxxxxxxxxxxxxxxx"

# Task 7.0a — mock session seam. Leave UNSET (the default — do not set this
# in .env for normal/production use) to use the real Managed Agents client in
# lib/agents/session.ts, completely unchanged. Set to exactly "1" (e.g. in a
# local .env, or CI/Playwright env, never checked in) to make
# runGeneratorSession/runVerifierSession/sendFollowUp return deterministic
# canned results instead of calling the real Anthropic API. Lets 7.2-7.4's UI
# and 9.0's Playwright suite exercise the final/needs_review/error result
# states without a live deployment (task 6.0b) or the CARVE_*_AGENT_ID /
# CARVE_ENVIRONMENT_ID / CARVE_VAULT_ID values above. NEVER set this in
# production. See lib/agents/session.ts's "Mock seam" section for the exact
# MOCK_FLAG_ME / MOCK_ERROR_ME trigger mechanism a test uses to control which
# outcome a given call produces.
CARVE_MOCK_AGENTS=

# Weekly Action Cadence (FR-04) / production cron authentication.
# Generate a long random value and configure the same value in the scheduler.
CRON_SECRET="generate-a-long-random-value-do-not-use-this-placeholder"

# Weekly Action Cadence email delivery (FR-04). Create a verified sending
# domain in Resend, then use its approved From address here.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="Carve <actions@example.com>"
